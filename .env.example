# Java、MCP 与 Deep Agent 共用的 Docker 外部网络名称。
AETHER_SHARED_NETWORK=aether-mcp-server_default

# Java 回调接口在共享网络中的基础地址。
AETHER_DEEP_AGENT_CALLBACK_BASE_URL=http://aether-admin:8080

# MCP Streamable HTTP 接口在共享网络中的地址。
AETHER_DEEP_AGENT_MCP_URL=http://aether-mcp:8000/mcp

# Java 与 Deep Agent 回调验签共用的密钥，必须与 Java 一致。
AETHER_DEEP_AGENT_SHARED_SECRET=aether-deep-agent-dev-secret-change-me

# Deep Agent 使用的 LangChain 模型标识。
AETHER_DEEP_AGENT_MODEL=deepseek-v4-flash

# OpenAI 兼容模型的 API 基础地址；官方地址时可留空。
OPENAI_BASE_URL=https://api.deepseek.com

# Anthropic 模型的 API 密钥。
ANTHROPIC_API_KEY=

# Google 模型的 API 密钥。
GOOGLE_API_KEY=

# 生产环境必须在未提交的 .env 或密钥管理系统中替换共享密钥和模型 API Key。
